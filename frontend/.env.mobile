# The store app (npm run build:mobile → vite --mode mobile). Everything here is PUBLIC by design:
# it ships inside the app. Secrets (RevenueCat's secret key, Stripe, YMove) live on the server only.

# The hosted Tiza the app signs up and in to (lib/app-account.js).
VITE_DEFAULT_SERVER=https://app.tiza.fit

# RevenueCat public SDK keys (Project settings → API keys → App specific keys).
VITE_RC_IOS_KEY=
VITE_RC_ANDROID_KEY=

# Google sign-in: the OAuth client ids. Web is what Android uses; iOS needs its own, plus its
# reversed id as a URL scheme in ios/App/App/Info.plist. The server lists all of them in
# GOOGLE_CLIENT_IDS. Apple needs nothing here on iPhone (the bundle id, in APPLE_CLIENT_IDS).
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=

# Shown on the paywall, as the stores require.
VITE_TERMS_URL=https://tiza.fit/terminos/
VITE_PRIVACY_URL=https://tiza.fit/privacidad/

# The app's numeric App Store id (App Store Connect → App Information → Apple ID): with it, a
# creator's code typed into the app opens the App Store's redemption of their Apple offer code
# with the code filled in. Without it, Apple's own sheet opens and the code is typed there.
VITE_APPLE_APP_ID=
