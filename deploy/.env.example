# What docker compose itself reads (copy to .env, chmod 600). docs/DEPLOY.md, step 5.

# The release to run: the images ghcr.io/jarima27/tiza-api and tiza-web carry it as their tag
# (the mirror's release workflow publishes both). Pinned on purpose, never "latest": an update is
# changing this line, `docker compose pull` and `docker compose up -d` — and going back is the same.
TIZA_VERSION=1.0.0
# Where the images come from, if the mirror ever moves.
# TIZA_IMAGES=ghcr.io/jarima27

# Cloudflare → Zero Trust → Networks → Tunnels → your tunnel → the token in the install command
# (the long string after --token). Only cloudflared receives it.
TUNNEL_TOKEN=

# When the nightly backup runs, in TZ.
BACKUP_AT=03:30
TZ=Europe/Madrid
