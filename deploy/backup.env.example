# The backup's settings and secrets (copy to backup.env, chmod 600). docs/DEPLOY.md, step 4.
# Only the backup service reads this file.

# The R2 bucket, through its S3 endpoint: s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<bucket>
# A bucket created with the EU jurisdiction has its own endpoint, with .eu. in it:
#   s3:https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com/tiza-backups
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.eu.r2.cloudflarestorage.com/tiza-backups

# The R2 API token's S3 credentials (Object Read & Write, this bucket only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Every backup is encrypted with this before it leaves the server. Long and random
# (`openssl rand -base64 32`), and kept in your password manager as well: without it the backups
# cannot be read by anyone — you included. A new server needs it to restore.
RESTIC_PASSWORD=

# Optional: a dead man's switch (healthchecks.io or similar). Pinged when a backup succeeds,
# /start when one begins and /fail when one fails, so a night without a backup e-mails you.
# BACKUP_PING_URL=https://hc-ping.com/<uuid>

# Retention (these are the defaults): the newest snapshot of each of the last 30 days and of each
# of the last 12 months.
# KEEP_DAILY=30
# KEEP_MONTHLY=12
