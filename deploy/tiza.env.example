# The app's settings and secrets on app.tiza.fit (copy to tiza.env, chmod 600). Only the api
# service reads this file. docs/DEPLOY.md, step 5; every variable is explained in
# docs/SELF_HOSTING.md and the repository's .env.example.

# ── Address ─────────────────────────────────────────────────────────────────────────────────
# Passkeys are bound to this exact name: settle it before anyone signs up (changing it later
# means everybody registers again).
RP_ID=app.tiza.fit
ORIGIN=https://app.tiza.fit
RP_NAME=Tiza

# ── Ways in ─────────────────────────────────────────────────────────────────────────────────
# An account is the way in: the trial, the Coach and the store app all hang off one.
ALLOW_GUEST=0
# E-mail and password, next to passkeys and Apple/Google: the store app's e-mail sign-in uses it.
PASSWORD_LOGIN=1
# After your own first sign-up: your profile id from data/db.json ("users"[].id).
# ADMIN_UIDS=

# ── Notifications ───────────────────────────────────────────────────────────────────────────
# The contact push services may write to about this server (defaults to ORIGIN).
# VAPID_SUBJECT=mailto:you@example.com

# ── Subscription: Stripe (website) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Webhook endpoint: https://app.tiza.fit/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Optional: a coupon offered with the annual plan to someone cancelling.
# STRIPE_SAVE_COUPON=
# The free days from sign-up, no card. Keep it equal to prices.trialDays in
# landing/site.config.json — the website promises that number.
TRIAL_DAYS=30
# Free days of a first web subscription taken out with a card (starts where the open trial ends).
# STRIPE_TRIAL_DAYS=0

# ── Subscription: App Store / Google Play (RevenueCat) ──────────────────────────────────────
# Webhook: https://app.tiza.fit/api/billing/revenuecat, with this exact Authorization header.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=pro

# ── Sign in with Apple / Google (store app) ─────────────────────────────────────────────────
APPLE_CLIENT_IDS=fit.tiza.app
GOOGLE_CLIENT_IDS=
# To revoke a deleted account's Apple tokens (Apple asks for it): a Sign in with Apple key.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----"

# ── Exercise videos (YMove) ─────────────────────────────────────────────────────────────────
# Stays on the server; the app never sees it.
YMOVE_API_KEY=
# YMOVE_VIDEOS=off      # the switch: apps stop asking and drop what they kept

# ── Product analytics (PostHog, from the server only) ───────────────────────────────────────
# POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
